import os
from dotenv import load_dotenv

# Load .env file
load_dotenv()


class Settings:
    # =========================
    # App
    # =========================
    ENV: str = os.getenv("ENV", "development")
    LOG_LEVEL: str = os.getenv("LOG_LEVEL", "INFO")

    # =========================
    # LLM Configuration
    # =========================
    GROQ_API_KEY: str | None = os.getenv("GROQ_API_KEY")
    OPENAI_API_KEY: str | None = os.getenv("OPENAI_API_KEY")
    GEMINI_API_KEY: str | None = os.getenv("GEMINI_API_KEY")

    LLM_PROVIDER: str = os.getenv("LLM_PROVIDER", "groq")
    LLM_MODEL: str | None = os.getenv("LLM_MODEL")

    # =========================
    # LangSmith
    # =========================
    LANGSMITH_API_KEY: str | None = os.getenv("LANGSMITH_API_KEY")
    LANGSMITH_PROJECT: str | None = os.getenv(
        "LANGSMITH_PROJECT", "multi-agent-orchestrator"
    )
    LANGSMITH_TRACING: bool = os.getenv(
        "LANGSMITH_TRACING", "false"
    ).lower() == "true"

    # =========================
    # Database
    # =========================
    MONGODB_URL: str = os.getenv(
        "MONGODB_URL", "mongodb://localhost:27017"
    )
    MONGODB_DB_NAME: str = os.getenv(
        "MONGODB_DB_NAME", "multi_agent_system"
    )

    # =========================
    # JWT Configuration
    # =========================
    JWT_SECRET_KEY: str = os.getenv("JWT_SECRET_KEY")

    # =========================
    # Google OAuth
    # =========================
    GOOGLE_CLIENT_ID: str | None = os.getenv("GOOGLE_CLIENT_ID")
    GOOGLE_CLIENT_SECRET: str | None = os.getenv("GOOGLE_CLIENT_SECRET")
    GOOGLE_REDIRECT_URI: str | None = os.getenv("GOOGLE_REDIRECT_URI")

    FRONTEND_URL: str = os.getenv(
        "FRONTEND_URL", "http://localhost:5173"
    )


# Singleton settings object
settings = Settings()
